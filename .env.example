# Copy to .env / set in your hosting provider's env settings. NEVER commit real secrets.

# Port the server listens on (default 8080)
PORT=8080

# HMAC secret issued by the Agent Games dashboard (Agent settings -> Rotate Secret,
# shown exactly once). Must match the dashboard value or preflight fails.
AGENT_GAMES_HMAC_SECRET=

# Steal the VFY strategy: 8 comma-separated integers
# [extractAmount(1-10), fortifyThreshold, minOpponentBalance, mode(0 normal|1 always HOLD), 0,0,0,0]
STEAL_STRATEGY_PARAMS=5,50,0,0,0,0,0,0

# Strategy salt (hex). MUST be fixed in production — if unset, a random salt is
# generated at startup, so the strategy commitment changes on every restart.
STEAL_STRATEGY_SALT=
